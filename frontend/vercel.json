{
    "version": 2,
    "builds": [
        {
            "src": "dist/server/server.mjs",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/dist/browser/assets/$1"
        },
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
            "dest": "/dist/browser/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/server/server.mjs"
        }
    ]
}