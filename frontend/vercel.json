{
    "version": 2,
    "builds": [
        {
            "src": "dist/frontend/server/server.mjs",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/dist/frontend/browser/assets/$1"
        },
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot))",
            "dest": "/dist/frontend/browser/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/frontend/server/server.mjs"
        }
    ],
    "functions": {
        "dist/frontend/server/server.mjs": {
            "maxDuration": 30
        }
    }
}